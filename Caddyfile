# Caddy 自动 HTTPS 反向代理
# 变量来自 docker-compose.yml 的 environment
#
# 认证说明：不使用 HTTP Basic Auth —— 移动端浏览器对其支持不稳定（XHR 401 反复弹窗）。
# 统一由应用令牌（X-Clipboard-Token）保护 /api/*，前端在页面内弹窗输入一次即可。
#
# http:// 块 → 80 端口直接服务（兼容 Cloudflare Flexible/Off 模式回源走 HTTP）
# https 块   → 443 端口 TLS（Full 模式 / DNS-only 直连）

http://{$CLIPBOARD_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
}

{$CLIPBOARD_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
}

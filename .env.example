# 复制本文件为 .env 并填写真实值（.env 不要提交到 git）
# 生成随机令牌（Linux/Mac/WSL）：
#   openssl rand -hex 32
# 生成 Caddy 基础认证密码哈希（任选其一）：
#   docker run --rm caddy:2 caddy hash-password --plaintext '你的密码'
# 或本地有 caddy 时：caddy hash-password --plaintext '你的密码'

CLIPBOARD_DOMAIN=clip.example.com
CLIPBOARD_TOKEN=改成一段随机长字符串，例如 openssl rand -hex 32 的输出
CLIPBOARD_BASIC_AUTH_USER=admin
CLIPBOARD_BASIC_AUTH_HASH=$2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
